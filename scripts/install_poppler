#!/usr/bin/env bash
# Install poppler-utils (pdftoppm, pdftotext, pdfinfo, ...), no-admin, into ~/.local.
#
# yazi previews PDFs with pdftoppm. poppler has no portable Linux release, so
# this takes the distro's own packages: `apt-get download` fetches the
# poppler-utils .deb and the libpoppler it needs (no root required), in exactly
# the version that matches the rest of the system's libraries. Both are
# unpacked to ~/.local/share/poppler, and each command gets a wrapper in
# ~/.local/bin that sets LD_LIBRARY_PATH, as for piper. libpoppler's own
# dependencies (cairo, nss, openjpeg, lcms2, ...) must already be installed;
# they usually are, and the script names the apt command if one is missing.
#
# With admin rights, `sudo apt install -y poppler-utils` is simpler.

set -euo pipefail

PREFIX="${HOME}/.local"
SHARE="${PREFIX}/share/poppler"
BIN="${PREFIX}/bin"

command -v apt-get >/dev/null || {
    echo "install_poppler: needs apt-get (Debian/Ubuntu); install poppler with the system package manager" >&2
    exit 1
}

# poppler-utils depends on one libpopplerNNN; its number changes per release.
LIB="$(apt-cache depends poppler-utils | sed -n 's/^ *Depends: \(libpoppler[0-9]\+\)$/\1/p' | head -1)"
[ -n "$LIB" ] || { echo "install_poppler: cannot find the libpoppler that poppler-utils depends on" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "Downloading  poppler-utils ${LIB}"
(cd "$tmp" && apt-get download -q poppler-utils "$LIB" >/dev/null)

echo "Extracting   -> ~/.local/share/poppler"
mkdir -p "$tmp/x"
for deb in "$tmp"/*.deb; do
    dpkg-deb -x "$deb" "$tmp/x"
done
rm -rf "$SHARE"
mkdir -p "$SHARE/bin" "$SHARE/lib"
cp -a "$tmp"/x/usr/bin/. "$SHARE/bin/"
cp -a "$tmp"/x/usr/lib/*/libpoppler.so.* "$SHARE/lib/"

missing="$(LD_LIBRARY_PATH="$SHARE/lib" ldd "$SHARE/bin/pdftoppm" | awk '/not found/{print $1}')"
if [ -n "$missing" ]; then
    echo "install_poppler: missing shared libraries: $missing" >&2
    echo "install with: sudo apt install -y poppler-utils" >&2
    exit 1
fi

echo "Installing   wrappers -> ~/.local/bin"
mkdir -p "$BIN"
for exe in "$SHARE"/bin/*; do
    name="$(basename "$exe")"
    cat > "$BIN/$name" <<EOF
#!/bin/sh
# Generated by toscpm scripts/install_poppler.
LD_LIBRARY_PATH="$SHARE/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}" exec "$SHARE/bin/$name" "\$@"
EOF
    chmod 755 "$BIN/$name"
done
