    ("~/.claude/CLAUDE.md",           "dotfiles/anyos/claude/CLAUDE.md",      None),
    ("~/.tmux.conf",                  "dotfiles/anyos/tmux.conf",             None),
    ("~/.zshrc",                      "dotfiles/macos/zshrc",                 "macos"),
    ("~/.bashrc",                     "dotfiles/linux/bashrc",                "linux"),
    ("~/.bash_aliases",               "dotfiles/linux/bash_aliases",          "linux"),
    ("~/.inputrc",                    "dotfiles/linux/inputrc",               "linux"),
    ("~/Documents/PowerShell/Microsoft.PowerShell_profile.ps1",
     "dotfiles/windows/powershell_profile.ps1", "windows"),
]


def is_linked(link, source):
    """True if `link` is a symlink already pointing at `source`.

    Uses os.path.samefile (inode comparison) rather than comparing
    resolved path strings, which is wrong on case-insensitive
    filesystems: Path.resolve() preserves the case it was handed, so a
    symlink stored as .../Repos/... never string-equals a REPO_DIR of
    .../repos/... even though they are the same directory.
    """
    try:
        return link.is_symlink() and source.exists() and os.path.samefile(link, source)
    except OSError:
        return False


def check_dotfiles(cur_os):
    ok, broken = 0, []
    for symlink_path, repo_rel, target_os in DOTFILES:
        if target_os is not None and target_os != cur_os:
            continue
        link = Path(symlink_path).expanduser()
        source = (REPO_DIR / repo_rel).resolve()
        if is_linked(link, source):
            ok += 1
        else:
            reason = "not a symlink" if link.exists() else "missing"
            broken.append((symlink_path, reason))

    total = ok + len(broken)
    if not broken:
        print(f"{OK} Dotfiles   {total}/{total} symlinked")
    else:
        details = ", ".join(f"{p} ({r})" for p, r in broken)
        print(f"{FAIL} Dotfiles   {ok}/{total} symlinked: {details}")
    return not broken


class SymlinkPrivilegeError(Exception):
    """Raised when Windows refuses to create a symlink for lack of privilege."""


def create_symlink(link, source):
    try:
        link.symlink_to(source)
    except OSError as e:
        if getattr(e, "winerror", None) == 1314:  # required privilege not held
            raise SymlinkPrivilegeError from e
        raise


SYMLINK_PRIVILEGE_HELP = (
    f"\n{FAIL} Cannot create symlinks: Windows is blocking this without elevated privileges.\n"
    "  Enable symlink creation without admin by turning on Developer Mode:\n"
    "    Settings > Privacy & security > For developers > Developer Mode (toggle On)\n"
    "  Or from an elevated PowerShell:\n"
    "    reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AppModelUnlock\" "
    "/t REG_DWORD /f /v AllowDevelopmentWithoutDevLicense /d 1\n"
    "  Then open a new terminal and re-run: toscpm link\n"
    "  (Alternatively, run this command from a terminal opened as Administrator.)"
)


def link_dotfiles(cur_os):
    for symlink_path, repo_rel, target_os in DOTFILES:
        if target_os is not None and target_os != cur_os:
            continue
        link = Path(symlink_path).expanduser()
        source = REPO_DIR / repo_rel

        if not source.exists():
            print(f"  skip {symlink_path} (source missing)")
            continue
        if is_linked(link, source):
            print(f"  {OK}    {symlink_path}")
            continue

        link.parent.mkdir(parents=True, exist_ok=True)
        if link.exists() or link.is_symlink():
            backup = link.with_suffix(link.suffix + ".bak")
            if backup.is_symlink() or backup.is_file():
                backup.unlink()
            elif backup.is_dir():
                shutil.rmtree(backup)
            link.rename(backup)
            print(f"  back {symlink_path} -> {backup.name}")

        create_symlink(link, source)
        print(f"  link {symlink_path} -> {repo_rel}")


# ---------------------------------------------------------------------------
# Bin scripts
# ---------------------------------------------------------------------------

# (command_name, repo_source_relative, os_filter_or_None)
# Executable helpers symlinked into ~/.local/bin so they land on PATH.
BIN_SCRIPTS = [
    ("deepsleep", "bin/deepsleep", "macos"),
    ("ptree",     "bin/ptree",     "linux"),
]


def check_bin(cur_os):
    ok, broken = 0, []
    for name, repo_rel, target_os in BIN_SCRIPTS:
        if target_os is not None and target_os != cur_os:
            continue
        link = LOCAL_BIN / name
        source = (REPO_DIR / repo_rel).resolve()
        if is_linked(link, source):
            ok += 1
        else:
            reason = "not a symlink" if link.exists() else "missing"
            broken.append((name, reason))

    total = ok + len(broken)
    if total == 0:
        return True
    if not broken:
        print(f"{OK} Bin        {total}/{total} linked")
    else:
        details = ", ".join(f"{n} ({r})" for n, r in broken)
        print(f"{FAIL} Bin        {ok}/{total} linked: {details} (run: toscpm link)")
    return not broken


def link_bin(cur_os):
    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
    for name, repo_rel, target_os in BIN_SCRIPTS:
        if target_os is not None and target_os != cur_os:
            continue
        link = LOCAL_BIN / name
        source = REPO_DIR / repo_rel

        if not source.exists():
            print(f"  skip {name} (source missing)")
            continue
        if is_linked(link, source):
            print(f"  {OK}    {BIN_DISP}/{name}")
            continue

        if link.exists() or link.is_symlink():
            link.rename(link.with_suffix(".bak"))
        create_symlink(link, source)
        print(f"  link {BIN_DISP}/{name} -> {repo_rel}")


# ---------------------------------------------------------------------------
# Self-install
# ---------------------------------------------------------------------------

def self_install_target(cur_os):
    """Return (path, kind) for the 'toscpm' launcher in ~/.local/bin.

    Windows cannot execute a script via a symlink, so there we install a
    'toscpm.bat' shim that forwards all arguments to the script instead.
    """
    if cur_os == "windows":
        return LOCAL_BIN / "toscpm.bat", "shim"
    return LOCAL_BIN / "toscpm", "symlink"


def windows_shim_content(script):
    return f'@echo off\npython "{script}" %*\n'


def check_self_install(cur_os):
    target, kind = self_install_target(cur_os)
    script = REPO_DIR / "toscpm"

    if kind == "shim":
        linked = target.is_file() and target.read_text() == windows_shim_content(script)
    else:
        linked = target.is_symlink() and target.resolve() == script.resolve()

    in_path = str(LOCAL_BIN) in os.environ.get("PATH", "").split(os.pathsep)
    if linked and in_path:
        print(f"{OK} Self       toscpm {VERSION} -> {BIN_DISP}/{target.name}")
        return True
    problems = []
    if not linked:
        problems.append("not linked")
    if not in_path:
        problems.append(f"{BIN_DISP} not in PATH")
    print(f"{FAIL} Self       {', '.join(problems)} (run: toscpm link)")
    return False


def link_self(cur_os):
    LOCAL_BIN.mkdir(parents=True, exist_ok=True)

    # Remove the stale launcher from the previous 'check' name.
    stale = LOCAL_BIN / "check"
    if stale.is_symlink():
        stale.unlink()
        print(f"  rm   {BIN_DISP}/check (renamed to toscpm)")

    target, kind = self_install_target(cur_os)
    script = REPO_DIR / "toscpm"

    if kind == "shim":
        content = windows_shim_content(script)
        if target.is_file() and target.read_text() == content:
            print(f"  {OK}    {BIN_DISP}/{target.name}")
            return
        if target.exists() or target.is_symlink():
            target.rename(target.with_suffix(".bak"))
        target.write_text(content)
        print(f"  shim {BIN_DISP}/{target.name} -> toscpm")
        return

    if target.is_symlink() and target.resolve() == script.resolve():
        print(f"  {OK}    {BIN_DISP}/toscpm")
        return
    if target.exists() or target.is_symlink():
        target.rename(target.with_suffix(".bak"))
    create_symlink(target, script)
    print(f"  link {BIN_DISP}/toscpm -> toscpm")


# ---------------------------------------------------------------------------
# Repo status
# ---------------------------------------------------------------------------

def check_repo():
    try:
        result = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=REPO_DIR, capture_output=True, text=True,
        )
    except FileNotFoundError:
        print(f"{FAIL} Repo       git not found")
        return True

    lines = [l for l in result.stdout.strip().splitlines() if l]
    if not lines:
        print(f"{OK} Repo       clean")
        return True
    print(f"{FAIL} Repo       {len(lines)} uncommitted change(s) in {REPO_DIR}")
    return False


# ---------------------------------------------------------------------------
# Git remotes
# ---------------------------------------------------------------------------

# Hosts we expect to be able to query, and the CLI that authenticates to each.
# Only hostnames live here — never tokens. Credentials stay in each CLI's own
# store (gh keyring / ~/.config/glab-cli), so this repo carries no secrets.
REMOTES = [
    ("github.com",            "gh"),
    ("gitlab.spang-lab.de",   "glab"),
    ("git.uni-regensburg.de", "glab"),
]


def check_remotes():
    ok, failed = 0, []
    for host, cli in REMOTES:
        if not shutil.which(cli):
            failed.append((host, f"{cli} not installed"))
            continue
        try:
            res = subprocess.run(
                [cli, "api", "user", "--hostname", host],
                capture_output=True, text=True, timeout=20,
            )
        except subprocess.TimeoutExpired:
            failed.append((host, "timed out"))
            continue
        if res.returncode == 0:
            ok += 1
        else:
            err = (res.stderr or res.stdout).strip().splitlines()
            failed.append((host, err[-1] if err else f"exit {res.returncode}"))

    total = ok + len(failed)
    if not failed:
        print(f"{OK} Remotes    {total}/{total} reachable")
    else:
        details = ", ".join(f"{h} ({r})" for h, r in failed)
        print(f"{FAIL} Remotes    {ok}/{total} reachable: {details}")
        print(f"           authenticate with: gh auth login  /  glab auth login --hostname <host>")
    return not failed


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_check(cur_os):
    missing = check_tools(cur_os)
    check_dotfiles(cur_os)
    check_bin(cur_os)
    check_self_install(cur_os)
    check_repo()
    check_remotes()
    if missing:
        print(f"\n  Install (no-admin):  toscpm install")
        print(f"  Show admin commands: toscpm install -n --admin")
    return 0


def cmd_link(cur_os):
    try:
        link_dotfiles(cur_os)
        link_bin(cur_os)
        link_self(cur_os)
    except SymlinkPrivilegeError:
        print(SYMLINK_PRIVILEGE_HELP)
        return 1
    return 0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="toscpm",
        description="Manage core dev tools, dotfiles, and repo status across OSes.",
    )
    parser.add_argument("-V", "--version", action="version", version=f"toscpm {VERSION}")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("check", help="health check: tools / dotfiles / self / repo")

    p_install = sub.add_parser("install", help="install missing (or named) tools, no-admin")
    p_install.add_argument("tools", nargs="*", help="specific tools (default: all missing)")
    p_install.add_argument("-n", "--dry-run", action="store_true", help="print commands instead of running them")
    p_install.add_argument("--admin", action="store_true", help="print admin (apt/brew/winget) commands (always dry)")
    p_install.add_argument("--all", action="store_true", help="target every tool, not just the missing ones")

    sub.add_parser("link", help="symlink dotfiles + install self into ~/.local/bin")

    args = parser.parse_args()
    cur_os = get_os()
    global ARCH
    ARCH = get_arch()

    if args.cmd == "install":
        return install(args.tools, args.all, args.dry_run, args.admin, cur_os)
    if args.cmd == "link":
        return cmd_link(cur_os)
    return cmd_check(cur_os)


if __name__ == "__main__":
    sys.exit(main())
