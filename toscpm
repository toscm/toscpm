#!/usr/bin/env python3
"""toscpm — manage core dev tools, dotfiles, and repo status across OSes.

Subcommands:
  toscpm check                health check: tools / dotfiles / self / repo / remotes
  toscpm install [TOOL...]    install missing (or named) tools, no-admin into ~/.local
      -n, --dry-run           print the commands instead of running them
      --admin                 print the admin (apt/brew/winget) commands (always dry)
      --all                   target every tool, not just the missing ones
  toscpm link                 symlink dotfiles + install self into ~/.local/bin
  toscpm --version            print the toscpm version (from the VERSION file)

Bare `toscpm` runs `check`.
"""

import argparse
import json
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parent
HOME = Path.home()
LOCAL_PREFIX = HOME / ".local"
LOCAL_BIN = LOCAL_PREFIX / "bin"

# Single source of truth for the version; kept in sync with the git tag and
# NEWS.md. Reading via REPO_DIR works through the ~/.local/bin symlink because
# __file__ is resolved above.
try:
    VERSION = (REPO_DIR / "VERSION").read_text().strip()
except OSError:
    VERSION = "unknown"

# Absolute paths for the commands we actually run; "~"-forms for display.
BIN = str(LOCAL_BIN)
PREFIX = str(LOCAL_PREFIX)
BIN_DISP = "~/.local/bin"
PREFIX_DISP = "~/.local"

OK = "✓"
FAIL = "✗"
SKIP = "–"


def get_os():
    system = platform.system().lower()
    if system == "darwin":
        return "macos"
    if system == "linux":
        return "linux"
    if system == "windows":
        return "windows"
    sys.exit(f"Unsupported OS: {system}")


def get_arch():
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return "x86_64"
    if m in ("aarch64", "arm64"):
        return "aarch64"
    sys.exit(f"Unsupported architecture: {m}")


# ---------------------------------------------------------------------------
# No-admin install recipes (Linux). macOS/Windows use the admin package
# manager directly (brew/winget are already non-privileged).
# ---------------------------------------------------------------------------

@dataclass
class GhBin:
    """Download a GitHub release archive, extract binaries into ~/.local/bin.

    Binaries are located by basename anywhere in the extracted tree, so we
    don't depend on the archive's internal directory layout.
    """
    repo: str
    assets: dict          # arch -> asset filename template ({ver} if versioned)
    wants: list           # list of (basename_in_archive, output_name)
    strip_v: bool = True  # tag "vX.Y.Z" -> ver "X.Y.Z"; False keeps tag as-is
    archive: str = "tar.gz"   # tar.gz | tar.xz | zip
    versioned: bool = True    # asset filename embeds the version


@dataclass
class GhDeb:
    """Download a GitHub release .deb, unpack it, drop binaries into ~/.local/bin.

    For tools whose only prebuilt Linux artifact is a Debian package (e.g.
    HTML Tidy). The .deb is unpacked no-admin with dpkg-deb (falling back to
    ar + tar), then wanted binaries are located by basename under the
    extracted tree — exactly like GhBin.
    """
    repo: str
    assets: dict          # arch -> asset filename template ({ver} if versioned)
    wants: list           # list of (basename_in_archive, output_name)
    strip_v: bool = True
    versioned: bool = True
    archive: str = "deb"  # fixed; kept so linux_steps can share the GhBin path


@dataclass
class GhTree:
    """Strip the top dir of a GitHub release archive into ~/.local.

    For tools that need their bundled lib/ + share/ runtime (nvim, pandoc).
    """
    repo: str
    assets: dict
    strip_v: bool = True
    archive: str = "tar.gz"
    versioned: bool = True


@dataclass
class GlBin:
    """Like GhBin, but for projects hosted on gitlab.com.

    Release assets live at /-/releases/<tag>/downloads/<asset>, and the
    latest tag is resolved via the releases/permalink/latest redirect.
    """
    repo: str
    assets: dict          # arch -> asset filename template ({ver} if versioned)
    wants: list           # list of (basename_in_archive, output_name)
    strip_v: bool = True
    archive: str = "tar.gz"
    versioned: bool = True


@dataclass
class NodeDist:
    """Node.js from nodejs.org/dist, stripped into ~/.local."""
    channel: str = "lts"      # "lts" or "current"
    assets: dict = field(default_factory=lambda: {
        "x86_64": "node-v{ver}-linux-x64.tar.xz",
        "aarch64": "node-v{ver}-linux-arm64.tar.xz",
    })


@dataclass
class Script:
    """An official installer one-liner that already targets ~/.local."""
    cmd: str


