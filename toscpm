def bin_candidates(tool, cur_os):
    b = tool.bin
    if isinstance(b, dict):
        b = b.get(cur_os, b["default"])
    return [b] if isinstance(b, str) else list(b)


def installed(tool, cur_os):
    return any(shutil.which(c) for c in bin_candidates(tool, cur_os))


# ---------------------------------------------------------------------------
# Latest-version discovery
# ---------------------------------------------------------------------------

def _get(url, method="GET"):
    req = urllib.request.Request(url, method=method, headers={"User-Agent": "toscpm"})
    return urllib.request.urlopen(req, timeout=15)


def gh_latest_tag(repo):
    """Resolve a repo's latest release tag via the releases/latest redirect.

    https://github.com/<repo>/releases/latest -> .../releases/tag/<tag>
    Avoids the api.github.com rate limit.
    """
    final = _get(f"https://github.com/{repo}/releases/latest", method="HEAD").geturl()
    return final.rstrip("/").rsplit("/", 1)[-1]


def node_latest(channel):
    with _get("https://nodejs.org/dist/index.json") as r:
        data = json.load(r)
    if channel == "lts":
        for entry in data:
            if entry.get("lts"):
                return entry["version"].lstrip("v")
    return data[0]["version"].lstrip("v")


def gh_resolve(spec, arch):
    """Return (version_display, asset_filename, download_url)."""
    template = spec.assets[arch]
    if not spec.versioned:
        return "latest", template, f"https://github.com/{spec.repo}/releases/latest/download/{template}"
    tag = gh_latest_tag(spec.repo)
    ver = tag[1:] if spec.strip_v and tag.startswith("v") else tag
    asset = template.format(ver=ver)
    return ver, asset, f"https://github.com/{spec.repo}/releases/download/{tag}/{asset}"


def gl_latest_tag(repo):
    """Resolve a gitlab.com project's latest release tag via the
    releases/permalink/latest redirect (mirrors gh_latest_tag).

    https://gitlab.com/<repo>/-/releases/permalink/latest -> .../releases/<tag>
    """
    final = _get(f"https://gitlab.com/{repo}/-/releases/permalink/latest", method="HEAD").geturl()
    return final.rstrip("/").rsplit("/", 1)[-1]


def gl_resolve(spec, arch):
    """Return (version_display, asset_filename, download_url) for a GitLab release."""
    template = spec.assets[arch]
    if not spec.versioned:
        return "latest", template, f"https://gitlab.com/{spec.repo}/-/releases/permalink/latest/downloads/{template}"
    tag = gl_latest_tag(spec.repo)
    ver = tag[1:] if spec.strip_v and tag.startswith("v") else tag
    asset = template.format(ver=ver)
    return ver, asset, f"https://gitlab.com/{spec.repo}/-/releases/{tag}/downloads/{asset}"


# ---------------------------------------------------------------------------
# Install planning: each step is (label, detail, shell_command)
# ---------------------------------------------------------------------------

def _extract(archive, src, dst):
    mk = f"mkdir -p {dst} && "
    if archive == "zip":
        return mk + f"unzip -qo {src} -d {dst}"
    if archive == "deb":
        return mk + f"{{ dpkg-deb -x {src} {dst} ; }} 2>/dev/null || ( cd {dst} && ar x {src} && tar xf data.tar.* )"
    flag = "-xJf" if archive == "tar.xz" else "-xzf"
    return mk + f"tar {flag} {src} -C {dst}"


def linux_steps(spec, t):
    """Build (version, steps) for a Linux no-admin recipe."""
    if isinstance(spec, Script):
        return None, [("Installing", "official installer", spec.cmd)]

    if isinstance(spec, NodeDist):
        ver = node_latest(spec.channel)
        asset = spec.assets[ARCH].format(ver=ver)
        url = f"https://nodejs.org/dist/v{ver}/{asset}"
        return ver, [
            ("Downloading", asset, f"curl -fsSL {url} -o {t}/{asset}"),
            ("Extracting", f"-> {PREFIX_DISP}",
             f"mkdir -p {PREFIX} && tar -xJf {t}/{asset} -C {PREFIX} --strip-components=1"),
        ]

    resolve = gl_resolve if isinstance(spec, GlBin) else gh_resolve
    ver, asset, url = resolve(spec, ARCH)
    download = ("Downloading", asset, f"curl -fsSL {url} -o {t}/{asset}")

    if isinstance(spec, GhTree):
        flag = "-xJf" if spec.archive == "tar.xz" else "-xzf"
        return ver, [download, (
            "Extracting", f"-> {PREFIX_DISP}",
            f"mkdir -p {PREFIX} && tar {flag} {t}/{asset} -C {PREFIX} --strip-components=1")]

    steps = [download, ("Extracting", "unpack archive", _extract(spec.archive, f"{t}/{asset}", f"{t}/x"))]
    for base, out in spec.wants:
        steps.append((
            "Installing", f"{out} -> {BIN_DISP}/{out}",
            f'install -m 755 "$(find {t}/x -name {base} -type f | head -1)" {BIN}/{out}'))
    return ver, steps


def build_plan(tool, cur_os, t):
    """Return dict(status, version, steps). status: ok | admin_only | unavailable."""
    primary = bin_candidates(tool, cur_os)[0]

    if cur_os != "linux":
        cmd = tool.admin.get(cur_os)
        if not cmd:
            return {"status": "unavailable"}
        # winget/brew install onto the system PATH, not ~/.local/bin, so verify
        # by resolving the tool through PATH rather than a fixed location.
        verify = ("Verifying", f"{primary} {tool.version_flag}", f"{primary} {tool.version_flag}")
        return {"status": "ok", "version": None, "steps": [("Installing", cmd, cmd), verify]}

    if tool.user_linux is None:
        return {"status": "admin_only" if tool.admin.get("linux") else "unavailable"}

    # Linux no-admin recipes install binaries into ~/.local/bin, so verify there.
    verify = ("Verifying", f"{primary} {tool.version_flag}", f"{BIN}/{primary} {tool.version_flag}")
    ver, steps = linux_steps(tool.user_linux, t)
    steps.append(verify)
    return {"status": "ok", "version": ver, "steps": steps}


# ---------------------------------------------------------------------------
# install command
# ---------------------------------------------------------------------------

def run_env(cur_os):
    """Environment for running install/verify steps.

    On Windows a `winget install` writes the tool's directory into the user
    PATH in the registry, but the current process keeps its stale PATH — so a
    freshly installed tool is invisible to the Verifying step run in the same
    session. Rebuild PATH from the registry (machine + user, plus ~/.local/bin)
    so verification sees just-installed tools. Returns None elsewhere, letting
    subprocess inherit the environment unchanged.
    """
    if cur_os != "windows":
        return None
    import winreg
    parts = [str(LOCAL_BIN)]
    for root, sub in ((winreg.HKEY_LOCAL_MACHINE,
                       r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment"),
                      (winreg.HKEY_CURRENT_USER, "Environment")):
        try:
            with winreg.OpenKey(root, sub) as key:
                parts.append(os.path.expandvars(winreg.QueryValueEx(key, "Path")[0]))
        except OSError:
            pass
    env = dict(os.environ)
    env["PATH"] = os.pathsep.join([*parts, env.get("PATH", "")])
    return env


def select_targets(names, do_all, cur_os):
    by_name = {tool.name: tool for tool in TOOLS}
    if names:
        targets = []
        for n in names:
            if n not in by_name:
                sys.exit(f"unknown tool: {n} (known: {', '.join(by_name)})")
            targets.append(by_name[n])
        return targets
    if do_all:
        return list(TOOLS)
    return [t for t in TOOLS if t.admin.get(cur_os) and not installed(t, cur_os)]


def show_admin_commands(targets, cur_os):
    groups, standalone = {}, []
    for tool in targets:
        cmd = tool.admin.get(cur_os)
        if not cmd:
            continue
        for prefix in ("brew install ", "sudo apt install -y ", "winget install "):
            if cmd.startswith(prefix):
                groups.setdefault(prefix.rstrip(), []).append(cmd[len(prefix):])
                break
        else:
            standalone.append(cmd)
    for prefix, pkgs in groups.items():
        print(f"  {prefix} {' '.join(pkgs)}")
    for cmd in standalone:
        print(f"  {cmd}")


def install(names, do_all, dry, admin, cur_os):
    targets = select_targets(names, do_all, cur_os)
    if not targets:
        print("Nothing to install — all tracked tools are present.")
        return 0

    if admin:
        show_admin_commands(targets, cur_os)
        return 0

    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
    if dry:
        print('t="$(mktemp -d)"\n')

    n_ok = n_skip = n_fail = 0
    for tool in targets:
        tmp = None
        try:
            if dry:
                plan = build_plan(tool, cur_os, '"$t"')
            else:
                tmp = tempfile.mkdtemp(prefix=f"toscpm-{tool.name}-")
                plan = build_plan(tool, cur_os, tmp)
        except Exception as e:
            print(f"{FAIL} {tool.name}: cannot resolve latest version ({e})")
            n_fail += 1
            if tmp:
                shutil.rmtree(tmp, ignore_errors=True)
            continue

        status = plan["status"]
        if status == "admin_only":
            print(f"{SKIP} {tool.name} skipped (admin-only — see: toscpm install -n --admin {tool.name})")
            n_skip += 1
            continue
        if status == "unavailable":
            print(f"{SKIP} {tool.name} not available on {cur_os}")
            n_skip += 1
            continue

        ver, steps = plan["version"], plan["steps"]
        tag = f" ({ver})" if ver else ""

        if dry:
            print(f"# {tool.name}{tag}")
            for _, _, cmd in steps:
                print(cmd)
            print()
            continue

        print(f"{tool.name}{tag}")
        ok = True
        for label, detail, cmd in steps:
            res = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                                 env=run_env(cur_os))
            if label == "Verifying" and res.returncode == 0:
                out = (res.stdout or res.stderr).strip().splitlines()
                print(f"  {label:<12} {detail} -> {out[0] if out else ''}")
            else:
                print(f"  {label:<12} {detail}")
            if res.returncode != 0:
                err = (res.stderr or res.stdout).strip().splitlines()
                reason = err[0] if err else f"exit {res.returncode}"
                print(f"  {FAIL} failed at {label}: {reason}")
                ok = False
                break
        if ok:
            print(f"  {OK} {tool.name} installed{tag}")
            n_ok += 1
        else:
            n_fail += 1
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)

    if not dry:
        print(f"\nInstalled {n_ok}, skipped {n_skip}, failed {n_fail}")
        if str(LOCAL_BIN) not in os.environ.get("PATH", "").split(os.pathsep):
            print(f"{FAIL} {BIN_DISP} is not on PATH — add it to use the installed tools.")
    return 1 if n_fail else 0


# ---------------------------------------------------------------------------
# check: tools
# ---------------------------------------------------------------------------

def check_tools(cur_os):
    installed_n, missing = 0, []
    for tool in TOOLS:
        if not tool.admin.get(cur_os):
            continue
        if installed(tool, cur_os):
            installed_n += 1
        else:
            missing.append(tool.name)

    if not missing:
        print(f"{OK} Tools      {installed_n} installed")
    else:
        print(f"{FAIL} Tools      {installed_n} installed, {len(missing)} missing: {', '.join(missing)}")
    return missing


