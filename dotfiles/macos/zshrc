# macOS zsh configuration.
#
# Everything portable lives in ../anyos/zshrc; only macOS-specific settings
# belong here. Resolve this file's real location (it is reached through the
# ~/.zshrc symlink) so the shared config is found regardless of where the
# toscpm repo is checked out.

# Uncomment to use the zsh-autocomplete plugin instead of builtin completion.
# ZSH_AUTOCOMPLETE_PLUGIN="$HOME/Repos/zsh-autocomplete/zsh-autocomplete.plugin.zsh"

source "${${(%):-%N}:A:h:h}/anyos/zshrc"

# Hide brew hints
export HOMEBREW_NO_ENV_HINTS=1

export VISUAL=code
export EDITOR=hx

export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
export PATH="$PATH:$HOME/Repos/capman/macos"
export PATH="$PATH:/opt/homebrew/lib/python3.14/site-packages/"
