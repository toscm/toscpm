if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
if command -v eza >/dev/null; then
    alias ls='eza'
    alias ll='eza -l'
    alias la='eza -la'
    alias l='eza -a'
    alias lt='eza --tree --level=2'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi
alias gaa='git add -A'
alias gcm='git commit -m'
alias gp='git push'
alias gs='git status'
alias gd='git diff'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
command -v bat >/dev/null || { command -v batcat >/dev/null && alias bat='batcat'; }
# fd/rg variants that also search dot folders (plain fd/rg keep their defaults).
#   fda, rga:   dot folders, but not .git and not gitignored paths
#   fdaa, rgaa: everything, including .git and gitignored paths
# Each prints the command it runs to stderr. Debian/Ubuntu ship fd as fdfind.
_run_shown() { { printf '+'; printf ' %q' "$@"; printf '\n'; } >&2; command "$@"; }
_fd_bin() { command -v fd >/dev/null && echo fd || echo fdfind; }
fda()  { _run_shown "$(_fd_bin)" --hidden --exclude .git "$@"; }
fdaa() { _run_shown "$(_fd_bin)" --hidden --no-ignore "$@"; }
rga()  { _run_shown rg --hidden --glob '!.git' "$@"; }
rgaa() { _run_shown rg --hidden --no-ignore "$@"; }
alias v='nvim'
# tmux-peer [session]: attach to a running session (default: the first one)
# from another terminal with its own current window. It joins the session's
# group, so both share the windows, and the extra session goes away on detach.
tmux-peer() {
    local target=${1:-$(tmux ls -F '#{session_name}' -f '#{?session_grouped,#{==:#{session_name},#{session_group}},1}' 2>/dev/null | head -1)}
    [ -n "$target" ] || { echo "tmux-peer: no tmux session running" >&2; return 1; }
    tmux new-session -t "$target" \; set-option destroy-unattached on
}
