if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
if command -v eza >/dev/null; then
    alias ls='eza'
    alias ll='eza -l'
    alias la='eza -la'
    alias l='eza -a'
    alias lt='eza --tree --level=2'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi
alias gaa='git add -A'
alias gcm='git commit -m'
alias gp='git push'
alias gs='git status'
alias gd='git diff'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
command -v bat >/dev/null || { command -v batcat >/dev/null && alias bat='batcat'; }
# fd and ripgrep: include dotfiles and dot folders, but skip .git.
# fd has no config file, so alias it (Debian/Ubuntu ship it as fdfind);
# ripgrep reads ~/.ripgreprc.
if command -v fd >/dev/null; then alias fd='fd --hidden --exclude .git'
elif command -v fdfind >/dev/null; then alias fd='fdfind --hidden --exclude .git'; fi
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
alias v='nvim'
# tmux-peer [session]: attach to a running session (default: the first one)
# from another terminal with its own current window. It joins the session's
# group, so both share the windows, and the extra session goes away on detach.
tmux-peer() {
    local target=${1:-$(tmux ls -F '#{session_name}' -f '#{?session_grouped,#{==:#{session_name},#{session_group}},1}' 2>/dev/null | head -1)}
    [ -n "$target" ] || { echo "tmux-peer: no tmux session running" >&2; return 1; }
    tmux new-session -t "$target" \; set-option destroy-unattached on
}
