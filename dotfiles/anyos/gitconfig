[alias]
	lg1 = log --graph --decorate --pretty=format:'%C(auto)%h %Cgreen%ad %Creset%s %Cblue%d %Creset' --date=iso
[core]
	editor = code --wait
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[push]
	followTags = true
[credential "https://git.overleaf.com"]
	provider = generic
[credential]
	helper = store
