[user]
	name = toscm
	email = tobias.schmidt331@gmail.com
[alias]
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
	lg = lg1
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = false
	side-by-side = false
	wrap-max-lines = 0
	# No line-number gutter: in the unified view delta leaves long lines to the
	# terminal, which wraps them to column 0, under the gutter. Without it they
	# wrap like ordinary text, and each hunk is headed by its path:line instead.
	line-numbers = false
	# less < 566 (e.g. Ubuntu 22.04) prints OSC 8 links as raw "8;;file://..." text.
	hyperlinks = false
	hunk-header-style = file line-number omit-code-fragment
	hunk-header-decoration-style = blue ul
	file-style = bold
	file-decoration-style = none
[push]
	followTags = true
[credential "https://git.overleaf.com"]
	provider = generic
[credential]
	helper = store
[credential "https://git.uni-regensburg.de"]
	provider = generic
