# Make the R language server index R packages that live in sub-directories of
# the opened folder, so that "Go to Symbol in Workspace" finds symbols from
# every repo under ~/repos rather than only from files already opened.
# This must stay outside the interactive() guard: the language server starts
# via `R --no-echo -e "languageserver::run()"`, which is not interactive.
options(languageserver.nested_packages_depth = 1)

if (interactive()) {
    a <- Sys.time()

    # Set Options
    CRAN <- "https://cloud.r-project.org"
    Bioc <- "https://bioconductor.org/packages/3.18/bioc"
    Ncpus <- parallel::detectCores(logical = FALSE) / 2
    options(
        help_type = "html",               setWidthOnResize = TRUE,
        tibble.print_max = 2000,          max.print = 2000,
        warnPartialMatchAttr = TRUE,      warnPartialMatchDollar = TRUE,
        repos = c(CRAN=CRAN, BioC=Bioc),  Ncpus = Ncpus
    )

    # Configure VSCode R Plugin
    home <- Sys.getenv("USERPROFILE", Sys.getenv("HOME"))
    if (any(grepl("VSCODE", names(Sys.getenv())))) {
        initR <- Sys.glob(file.path(home, ".vscode*/extensions/reditorsupport.r-*/R/session/init.R"))
        if (!length(initR) == 0) {
            initR <- initR[length(initR)] # source newest version
            cat("Sourcing: ", initR, "\n", sep = "")
            local(source(initR, chdir = TRUE, local = TRUE))
            options(
                vsc.use_httpgd = FALSE, vsc.globalenv = TRUE,
                vsc.plot = TRUE,        vsc.browser = TRUE,
                vsc.viewer = TRUE,      vsc.page_viewer = TRUE,
                vsc.view = TRUE,        vsc.helpPanel = TRUE,
                vsc.str.max.level = 2,  vsc.show_object_size = TRUE
            )
            Sys.setenv(TERM_PROGRAM = "vscode")
        } else {
            cat("Missing: $HOME/.vscode*/extensions/reditorsupport.r-*/R/session/init.R")
        }
    }

    # Import Packages
    Sys.setenv(`_R_S3_METHOD_REGISTRATION_NOTE_OVERWRITES_` = "FALSE")
    pkgs <- c("devtools", "toscutil")
    installed <- unname(utils::installed.packages()[, 1])
    wanted <- pkgs[!(pkgs %in% installed)]
    if (length(wanted > 0)) {
        Sys.setenv(DEBIAN_FRONTEND = "noninteractive")
        cat("Installing packages:", paste(wanted, collapse = ", "), "\n")
        utils::install.packages(wanted, Ncpus = parallel::detectCores(logical = FALSE))
    }
    if (length(pkgs) > 0) {
        cat("Loading Packages:")
        for (p in pkgs) {
            cat("", p)
            suppressMessages(suppressWarnings(library(p, character.only = TRUE)))
        }
        cat("\n")
    }
    Sys.setenv(`_R_S3_METHOD_REGISTRATION_NOTE_OVERWRITES_` = "TRUE")

    # Print Sys Locale
    x <- utils::capture.output(dput(l10n_info()))
    x <- paste(x, collapse = "")
    x <- gsub("\\s+", " ", x)
    x <- gsub("^list\\(", "", x)
    x <- gsub("\\)$", "", x)
    x <- gsub(" = ", "=", x)
    x <- gsub("`", "", x)
    x <- paste0(x, "\n")
    cat("Locale:", x)

    # Clean Up
    b <- Sys.time()
    cat(sprintf("Startup time: %s seconds\n", trimws(formatC(b - a, digits = 3))))
    rm(list = ls(envir = .GlobalEnv), envir = .GlobalEnv)
}
